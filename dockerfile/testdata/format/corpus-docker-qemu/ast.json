					"text": "# add backports for (potentially) newer QEMU firmware packages"
				},
				{
					"kind": "continuation",
					"text": "\tif grep backports /etc/apt/sources.list.d/debian.sources; then exit 1; fi; \\"
				},
				{
					"kind": "continuation",
					"text": "\tsed -ri -e 's/([[:space:]])([^[:space:]]+)-updates($|[[:space:]])/\\0\\1\\2-backports\\3/' /etc/apt/sources.list.d/debian.sources; \\"
				},
				{
					"kind": "continuation",
					"text": "\tgrep backports /etc/apt/sources.list.d/debian.sources; \\"
				},
				{
					"kind": "comment",
					"text": "# and add APT pinning to ensure we don't accidentally get QEMU from Debian"
				},
				{
					"kind": "continuation",
					"text": "\t{ \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Package: src:edk2'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Pin: release a=*-backports'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Pin-Priority: 600'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Package: src:qemu'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Pin: version *'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t\techo 'Pin-Priority: -10'; \\"
				},
				{
					"kind": "continuation",
					"text": "\t} \u003e /etc/apt/preferences.d/qemu.pref; \\"
				},
				{
					"kind": "continuation",
					"text": "\tapt-get update; \\"
				},
