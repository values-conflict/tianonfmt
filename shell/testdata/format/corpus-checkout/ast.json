{
	"type": "shell",
	"file": "input.sh",
	"stmts": [
		{
			"type": "call",
			"args": [
				"set",
				"-Eeuo",
				"pipefail",
				"-x"
			]
		},
		{
			"type": "call",
			"args": [
				":",
				"repository",
				"\"${INPUT_REPOSITORY:=$GITHUB_REPOSITORY}\""
			]
		},
		{
			"type": "call",
			"args": [
				":",
				"ref",
				"\"${FETCH_REF:=${INPUT_REF:-$GITHUB_SHA}}\""
			]
		},
		{
			"type": "call",
			"args": [
				":",
				"fetch-depth",
				"\"${depth:=${INPUT_FETCH_DEPTH:-1}}\""
			]
		},
		{
			"type": "call",
			"assigns": [
				"host=\"${INPUT_GITHUB_SERVER_URL:-$GITHUB_SERVER_URL}\""
			],
			"args": []
		},
		{
			"type": "call",
			"assigns": [
				"host=\"${host%/}\""
			],
			"args": []
		},
		{
			"type": "call",
			"args": [
				":",
				"host",
				"\"$host\""
			]
		},
		{
			"type": "call",
			"assigns": [
				"uid=\"$(id -u)\""
			],
			"args": []
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"\"$uid\"",
						"=",
						"0",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"assigns": [
						"chown=\"$(stat --format '%u:%g' \"$PWD\")\""
					],
					"args": []
				},
				{
					"type": "if",
					"cond": [
						{
							"type": "stmt",
							"cmd": {
								"type": "call",
								"args": [
									"command",
									"-v",
									"gosu"
								]
							},
							"redirs": [
								{
									"op": "\u003e",
									"word": "/dev/null"
								}
							]
						}
					],
					"then": [
						{
							"type": "call",
							"args": [
								"exec",
								"gosu",
								"\"$chown\"",
								"\"$BASH_SOURCE\"",
								"\"$@\""
							]
						}
					]
				}
			],
			"else": [
				{
					"type": "call",
					"assigns": [
						"chown="
					],
					"args": []
				}
			]
		},
		{
			"type": "call",
			"assigns": [
				"path=\"$PWD${INPUT_PATH:+/${INPUT_PATH#/}}\""
			],
			"args": []
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"-n",
						"\"${INPUT_SSH_KEY:-}\"",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"args": [
						"echo",
						"'::error::ssh-key is not yet supported'"
					]
				},
				{
					"type": "call",
					"args": [
						"exit",
						"1"
					]
				}
			]
		},
		{
			"type": "case",
			"word": "\"${INPUT_LFS:-}\"",
			"items": [
				{
					"patterns": [
						"''",
						"false",
						"no",
						"0"
					],
					"stmts": [
						{
							"type": "call",
							"args": [
								":"
							]
						}
					]
				},
				{
					"patterns": [
						"*"
					],
					"stmts": [
						{
							"type": "call",
							"args": [
								"echo",
								"'::error::lfs is not yet supported'"
							]
						},
						{
							"type": "call",
							"args": [
								"exit",
								"1"
							]
						}
					]
				}
			]
		},
		{
			"type": "case",
			"word": "\"${INPUT_SUBMODULES:-}\"",
			"items": [
				{
					"patterns": [
						"''",
						"false",
						"no",
						"0"
					],
					"stmts": [
						{
							"type": "call",
							"args": [
								":"
							]
						}
					]
				},
				{
					"patterns": [
						"*"
					],
					"stmts": [
						{
							"type": "call",
							"args": [
								"echo",
								"'::error::submodules is not yet supported'"
							]
						},
						{
							"type": "call",
							"args": [
								"exit",
								"1"
							]
						}
					]
				}
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"--version"
			]
		},
		{
			"type": "call",
			"args": [
				":",
				"set-safe-directory",
				"\"${INPUT_SET_SAFE_DIRECTORY=true}\""
			]
		},
		{
			"type": "case",
			"word": "\"$INPUT_SET_SAFE_DIRECTORY\"",
			"items": [
				{
					"patterns": [
						"true",
						"yes",
						"1"
					],
					"stmts": [
						{
							"type": "if",
							"cond": [
								{
									"type": "call",
									"args": [
										"[",
										"\"$uid\"",
										"=",
										"0",
										"]"
									]
								}
							],
							"then": [
								{
									"type": "call",
									"args": [
										"git",
										"config",
										"--global",
										"--add",
										"safe.directory",
										"\"$path\""
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "call",
			"args": [
				":",
				"clean",
				"\"${INPUT_CLEAN=true}\""
			]
		},
		{
			"type": "case",
			"word": "\"$INPUT_CLEAN\"",
			"items": [
				{
					"patterns": [
						"true",
						"yes",
						"1"
					],
					"stmts": [
						{
							"type": "if",
							"cond": [
								{
									"type": "binary",
									"op": "\u0026\u0026",
									"x": {
										"type": "call",
										"args": [
											"[",
											"-e",
											"\"$path\"",
											"]"
										]
									},
									"y": {
										"type": "block",
										"stmts": [
											{
												"type": "binary",
												"op": "||",
												"x": {
													"type": "stmt",
													"cmd": {
														"type": "call",
														"args": [
															"git",
															"-C",
															"\"$path\"",
															"clean",
															"-ffdx"
														]
													},
													"negated": true
												},
												"y": {
													"type": "stmt",
													"cmd": {
														"type": "call",
														"args": [
															"git",
															"-C",
															"\"$path\"",
															"reset",
															"--hard",
															"HEAD"
														]
													},
													"negated": true
												}
											}
										]
									}
								}
							],
							"then": [
								{
									"type": "call",
									"args": [
										"find",
										"\"$path\"",
										"-mindepth",
										"1",
										"-delete"
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "call",
			"args": [
				"mkdir",
				"-p",
				"\"$path\""
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"init",
				"--quiet",
				"\"$path\""
			]
		},
		{
			"type": "call",
			"args": [
				"cd",
				"\"$path\""
			]
		},
		{
			"type": "binary",
			"op": "||",
			"x": {
				"type": "call",
				"args": [
					"git",
					"remote",
					"remove",
					"origin"
				]
			},
			"y": {
				"type": "call",
				"args": [
					":"
				]
			}
		},
		{
			"type": "call",
			"args": [
				"git",
				"remote",
				"add",
				"origin",
				"\"$host/${INPUT_REPOSITORY%.git}.git\""
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"config",
				"--local",
				"gc.auto",
				"0"
			]
		},
		{
			"type": "call",
			"assigns": [
				"credsConfig=\"$(mktemp \"${RUNNER_TEMP}/git-credentials-XXXXXXXXXX.config\")\""
			],
			"args": []
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"-n",
						"\"$chown\"",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"args": [
						"chown",
						"\"$chown\"",
						"\"$credsConfig\""
					]
				}
			]
		},
		{
			"type": "call",
			"args": [
				"set",
				"+x"
			]
		},
		{
			"type": "call",
			"assigns": [
				"b64token=\"$(tr -d '\\n' \u003c\u003c\u003c \"x-access-token:$INPUT_TOKEN\" | base64 --wrap=0)\""
			],
			"args": []
		},
		{
			"type": "stmt",
			"cmd": {
				"type": "call",
				"args": [
					"printf",
					"'[http \"%s/\"]\\n\\textraheader = AUTHORIZATION: basic %s\\n'",
					"\"$host\"",
					"\"$b64token\""
				]
			},
			"redirs": [
				{
					"op": "\u003e",
					"word": "\"$credsConfig\""
				}
			]
		},
		{
			"type": "call",
			"args": [
				"unset",
				"b64token"
			]
		},
		{
			"type": "call",
			"args": [
				"set",
				"-x"
			]
		},
		{
			"type": "call",
			"assigns": [
				"gitDir=\"$(git rev-parse --absolute-git-dir)\""
			],
			"args": []
		},
		{
			"type": "call",
			"assigns": [
				"gitDir=\"$(readlink -f \"$gitDir\")\""
			],
			"args": []
		},
		{
			"type": "call",
			"args": [
				"git",
				"config",
				"--local",
				"\"includeIf.gitdir:${gitDir}.path\"",
				"\"$credsConfig\""
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"config",
				"--local",
				"\"includeIf.gitdir:${gitDir}/worktrees/*.path\"",
				"\"$credsConfig\""
			]
		},
		{
			"type": "call",
			"assigns": [
				"repoName=\"${INPUT_REPOSITORY##*/}\""
			],
			"args": []
		},
		{
			"type": "call",
			"assigns": [
				"hostGitDir=\"/home/runner/work/${repoName}/${repoName}${INPUT_PATH:+/${INPUT_PATH#/}}/.git\""
			],
			"args": []
		},
		{
			"type": "call",
			"assigns": [
				"hostCredsConfig=\"/home/runner/work/_temp/${credsConfig##*/}\""
			],
			"args": []
		},
		{
			"type": "call",
			"args": [
				"git",
				"config",
				"--local",
				"\"includeIf.gitdir:${hostGitDir}.path\"",
				"\"$hostCredsConfig\""
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"config",
				"--local",
				"\"includeIf.gitdir:${hostGitDir}/worktrees/*.path\"",
				"\"$hostCredsConfig\""
			]
		},
		{
			"type": "call",
			"assigns": [
				"fetchArgs=(\\\n\t--prune\n\t--no-tags\n\t--no-recurse-submodules # TODO optional submodules\n\torigin\n)"
			],
			"args": []
		},
		{
			"type": "call",
			"args": [
				":",
				"show-progress",
				"\"${INPUT_SHOW_PROGRESS=true}\""
			]
		},
		{
			"type": "case",
			"word": "\"$INPUT_SHOW_PROGRESS\"",
			"items": [
				{
					"patterns": [
						"true",
						"yes",
						"1"
					],
					"stmts": [
						{
							"type": "call",
							"assigns": [
								"fetchArgs+=(--progress)"
							],
							"args": []
						}
					]
				},
				{
					"patterns": [
						"*"
					],
					"stmts": [
						{
							"type": "call",
							"assigns": [
								"fetchArgs+=(--no-progress)"
							],
							"args": []
						}
					]
				}
			]
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"-n",
						"\"${INPUT_FILTER:-}\"",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"assigns": [
						"fetchArgs+=(\"--filter=$INPUT_FILTER\")"
					],
					"args": []
				}
			],
			"elifs": [
				{
					"cond": [
						{
							"type": "call",
							"args": [
								"[",
								"-n",
								"\"${INPUT_SPARSE_CHECKOUT:-}\"",
								"]"
							]
						}
					],
					"then": [
						{
							"type": "call",
							"assigns": [
								"fetchArgs+=('--filter=blob:none')"
							],
							"args": []
						}
					]
				}
			]
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"\"$depth\"",
						"=",
						"'0'",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"assigns": [
						"fetchRefspecs=('+refs/heads/*:refs/remotes/origin/*' '+refs/tags/*:refs/tags/*')"
					],
					"args": []
				},
				{
					"type": "case",
					"word": "\"$FETCH_REF\"",
					"items": [
						{
							"patterns": [
								"refs/pull/*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"prBranch=\"${FETCH_REF#refs/}\""
									],
									"args": []
								},
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs+=(\"+${FETCH_REF}:refs/remotes/${prBranch}\")"
									],
									"args": []
								}
							]
						}
					]
				}
			],
			"else": [
				{
					"type": "call",
					"assigns": [
						"fetchArgs+=(\"--depth=$depth\")"
					],
					"args": []
				},
				{
					"type": "case",
					"word": "\"$FETCH_REF\"",
					"items": [
						{
							"patterns": [
								"refs/heads/*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"branch=\"${FETCH_REF#refs/heads/}\""
									],
									"args": []
								},
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs=(\"+${FETCH_REF}:refs/remotes/origin/${branch}\")"
									],
									"args": []
								}
							]
						},
						{
							"patterns": [
								"refs/tags/*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs=(\"+${FETCH_REF}:${FETCH_REF}\")"
									],
									"args": []
								}
							]
						},
						{
							"patterns": [
								"refs/pull/*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"prBranch=\"${FETCH_REF#refs/}\""
									],
									"args": []
								},
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs=(\"+${FETCH_REF}:refs/remotes/${prBranch}\")"
									],
									"args": []
								}
							]
						},
						{
							"patterns": [
								"refs/*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs=(\"+${FETCH_REF}:${FETCH_REF}\")"
									],
									"args": []
								}
							]
						},
						{
							"patterns": [
								"*"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs=(\"${FETCH_REF}:\")"
									],
									"args": []
								}
							]
						}
					]
				},
				{
					"type": "call",
					"args": [
						":",
						"fetch-tags",
						"\"${INPUT_FETCH_TAGS=false}\""
					]
				},
				{
					"type": "case",
					"word": "\"$INPUT_FETCH_TAGS\"",
					"items": [
						{
							"patterns": [
								"true",
								"yes",
								"1"
							],
							"stmts": [
								{
									"type": "call",
									"assigns": [
										"fetchRefspecs+=('+refs/tags/*:refs/tags/*')"
									],
									"args": []
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "call",
			"args": [
				"git",
				"fetch",
				"\"${fetchArgs[@]}\"",
				"\"${fetchRefspecs[@]}\""
			]
		},
		{
			"type": "if",
			"cond": [
				{
					"type": "call",
					"args": [
						"[",
						"-n",
						"\"${INPUT_SPARSE_CHECKOUT:-}\"",
						"]"
					]
				}
			],
			"then": [
				{
					"type": "call",
					"args": [
						":",
						"sparse-checkout-cone-mode",
						"\"${INPUT_SPARSE_CHECKOUT_CONE_MODE=true}\""
					]
				},
				{
					"type": "case",
					"word": "\"$INPUT_SPARSE_CHECKOUT_CONE_MODE\"",
					"items": [
						{
							"patterns": [
								"true",
								"yes",
								"1"
							],
							"stmts": [
								{
									"type": "call",
									"args": [
										"git",
										"sparse-checkout",
										"init",
										"--cone"
									]
								}
							]
						},
						{
							"patterns": [
								"*"
							],
							"stmts": [
								{
									"type": "call",
									"args": [
										"git",
										"sparse-checkout",
										"init"
									]
								}
							]
						}
					]
				},
				{
					"type": "binary",
					"op": "|",
					"x": {
						"type": "call",
						"args": [
							"printf",
							"'%s\\n'",
							"\"$INPUT_SPARSE_CHECKOUT\""
						]
					},
					"y": {
						"type": "call",
						"args": [
							"git",
							"sparse-checkout",
							"set",
							"--stdin"
						]
					}
				}
			]
		},
		{
			"type": "case",
			"word": "\"$FETCH_REF\"",
			"items": [
				{
					"patterns": [
						"refs/heads/*"
					],
					"stmts": [
						{
							"type": "call",
							"assigns": [
								"branch=\"${FETCH_REF#refs/heads/}\""
							],
							"args": []
						},
						{
							"type": "call",
							"args": [
								"git",
								"checkout",
								"--progress",
								"--force",
								"-B",
								"\"$branch\"",
